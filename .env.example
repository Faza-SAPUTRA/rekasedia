DATABASE_URL=postgresql://postgres:***@db.project-ref.supabase.co:5432/postgres
PORT=3001
VITE_USE_MOCK=false

# Telegram Bot Notification (opsional — isi jika mau aktifkan notif)
# DM admin: notifikasi permintaan/peminjaman baru
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Grup guru: notifikasi approve/reject/reminder, guru di-tag otomatis
# Isi dengan chat id grup (negatif, contoh -1001234567890)
TELEGRAM_TEACHER_GROUP_CHAT_ID=
# Opsional: secret token webhook, harus sama dengan secret_token saat setWebhook
TELEGRAM_WEBHOOK_SECRET=
# Opsional: URL publik aplikasi, dipakai oleh skrip setup webhook
APP_BASE_URL=
